NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gaijin_sushi?schema=public
FRONTEND_ORIGIN=http://localhost:5173,https://gaijin-sushi-ivanovka-pex1.vercel.app
ADMIN_SESSION_DAYS=7
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=replace-with-a-random-password-at-least-12-characters

# Gemini API key for automatic menu translation in /admin (free: https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Optional: Gemini model to try first (defaults to gemini-3.8-flash, then gemini-3.5-flash-lite, gemini-3.6-flash).
GEMINI_MODEL=

# GoPay credentials: obtain from GoPay merchant support.
GOPAY_ENABLED=false
GOPAY_BASE_URL=
GOPAY_MERCHANT_ID=
GOPAY_SECRET=

# Paloma365 credentials and API access: obtain and confirm capabilities with Paloma365.
PALOMA_ENABLED=false
PALOMA_BASE_URL=
PALOMA_TOKEN=

# Telegram BotFather token and destination chat IDs.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
